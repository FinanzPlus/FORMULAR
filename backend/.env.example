# Configuration du serveur
PORT=5000

# ─── Configuration SMTP T-online ──────────────────────────────────────────────
# Serveur SMTP T-online (Deutsche Telekom)
EMAIL_HOST=securesmtp.t-online.de
EMAIL_PORT=587

# Votre adresse e-mail T-online (ex: maxmuster@t-online.de)
EMAIL_USER=votre_adresse@t-online.de

# Votre mot de passe T-online
# Attention : si vous utilisez la double authentification (2FA), vous devez
# générer un "App-Passwort" dans les paramètres de votre compte T-online.
EMAIL_PASS=votre_mot_de_passe_t-online

# Adresse e-mail de destination (où les demandes seront envoyées)
EMAIL_DEST=kontakt_finanzplusaustria@proton.me

# Note: Renommez ce fichier en .env et remplissez vos informations réelles
