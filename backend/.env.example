# Configuration du serveur
PORT=5000

# ─── Configuration SMTP Gmail ─────────────────────────────────────────────────
# Votre adresse Gmail
EMAIL_USER=votre_adresse@gmail.com

# App Password Gmail (PAS votre mot de passe normal)
# Pour le générer :
# 1. Aller sur https://myaccount.google.com/security
# 2. Activer la validation en 2 étapes
# 3. Chercher "Mots de passe des applications"
# 4. Créer un mot de passe pour "Autre (nom personnalisé)" → "Render"
# 5. Copier le mot de passe généré (16 caractères)
EMAIL_PASS=xxxx xxxx xxxx xxxx

# Adresse email de destination (où les demandes seront envoyées)
EMAIL_DEST=kontakt_finanzplusaustria@proton.me

# Note: Renommez ce fichier en .env et remplissez vos informations réelles
